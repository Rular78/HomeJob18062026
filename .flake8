# Максимально допустимая длина строки. По умолчанию: 79 [citation:1]
# В современных проектах часто используют 88 (для совместимости с Black) или 120 [citation:2].
max-line-length = 80

# Список ошибок и предупреждений, которые следует игнорировать.
# Часто игнорируют конфликты с форматтерами вроде Black (E203, W503) и некоторые другие [citation:4][citation:8].
ignore = E203, W503, E501, E266

# Список ошибок и предупреждений, которые нужно включить (если они выключены по умолчанию) [citation:1][citation:4].
select = B,C,E,F,W,T4

# Порог сложности Маккейба (McCabe). Значение выше 10-15 часто считается сигналом для рефакторинга [citation:1][citation:2].
max-complexity = 10

# Каталоги и файлы, которые Flake8 должен пропускать при проверке [citation:1][citation:9].
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    venv,
    migrations,
    .idea,
    .mypy_cache
